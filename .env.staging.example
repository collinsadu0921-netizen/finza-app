# Finza staging environment — copy to `.env.staging` (gitignored) for local staging runs.
# Never commit real secrets. Never point this file at production Supabase or app.finza.africa.
#
#   cp .env.staging.example .env.staging
#
# Fill values from the staging Supabase project adonhhtooawkeemdqqeo and from
# Paystack test mode. Do not copy production keys.
#
# Identity: FINZA_DEPLOYMENT_ENV=staging is required. NODE_ENV is not a staging signal.
# Preview deployments on Vercel often run with NODE_ENV=production.
#
# See docs/remediation/service/STAGING_DEPLOYMENT_RUNBOOK.md

# ── Identity ────────────────────────────────────────────────────────────────

FINZA_DEPLOYMENT_ENV=staging

# ── Supabase (staging project only) ─────────────────────────────────────────

# The values below use the existing app variable names.
# NEXT_PUBLIC_SUPABASE_ANON_KEY must be a staging sb_publishable_ key.
# SUPABASE_SERVICE_ROLE_KEY must be a staging sb_secret_ key.
# Do not paste legacy eyJ anon or service_role JWTs. Those keys are disabled.
NEXT_PUBLIC_SUPABASE_URL=https://adonhhtooawkeemdqqeo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_STAGING_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_STAGING_SECRET_KEY

# Optional direct Postgres. Keep YOUR_PASSWORD as a placeholder until filled locally.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.adonhhtooawkeemdqqeo.supabase.co:5432/postgres

# Block accidental use of production (seed scripts + local checks)
FINZA_PRODUCTION_SUPABASE_PROJECT_REF=qjxhibvbmzogyzbhswjj
FINZA_PRODUCTION_APP_URLS=app.finza.africa,finza.africa

# ── App URL (staging / Vercel preview only) ───────────────────────────────────

# Must not be https://app.finza.africa
NEXT_PUBLIC_APP_URL=https://REPLACE_WITH_STAGING_PREVIEW_HOST.vercel.app
NEXT_PUBLIC_SITE_URL=https://REPLACE_WITH_STAGING_PREVIEW_HOST.vercel.app

# ── Payments — Paystack test mode only ────────────────────────────────────────

PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_ME

# Set to true only on the verified staging preview, after test keys are installed.
# Leave false in this template so a copied file does not enable charges.
FINZA_TENANT_INVOICE_ONLINE_PAYMENTS_ENABLED=false

FINZA_SUBSCRIPTION_PAYMENT_GATEWAY=paystack

HUBTEL_ENABLED=false
HUBTEL_MODE=test
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_WEBHOOK_SECRET=
HUBTEL_WEBHOOK_PROCESSING_ENABLED=false
HUBTEL_STATUS_CHECK_URL_TEMPLATE=
HUBTEL_STATUS_PROXY_URL=
HUBTEL_STATUS_PROXY_SECRET=

TENANT_PAYMENT_CONFIG_ENCRYPTION_KEY=REPLACE_WITH_STAGING_ONLY_64_HEX

# ── Email ─────────────────────────────────────────────────────────────────────
# disabled: leave RESEND_API_KEY empty so staging cannot send.
# allowlist: set FINZA_STAGING_EMAIL_ALLOWLIST to explicit test inboxes only.

FINZA_STAGING_EMAIL_MODE=disabled
FINZA_STAGING_EMAIL_ALLOWLIST=

RESEND_API_KEY=
RESEND_FROM=Finza Staging <onboarding@resend.dev>
RESEND_WEBHOOK_SECRET=

# ── Cron / internal (staging-only secrets) ────────────────────────────────────

CRON_SECRET=
REMINDER_API_KEY=

# ── Optional integrations ─────────────────────────────────────────────────────

META_WHATSAPP_APP_ID=
META_WHATSAPP_APP_SECRET=

FINZA_INBOUND_EMAIL_DOMAIN=

RECEIPT_OCR_USE_STUB=true

FORENSIC_ALERT_ENABLED=false
FORENSIC_ALERT_EMAIL=
FORENSIC_ALERT_SLACK_WEBHOOK=

ALLOW_STAGING_LOAD_SEED=false
STAGING_LOAD_TENANT_EMAIL=staging-load@example.invalid
STAGING_LOAD_BUSINESS_ID=
